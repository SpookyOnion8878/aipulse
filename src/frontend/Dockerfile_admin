# Dockerfile — Admin Panel (Streamlit)

FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/

EXPOSE 8081

ENV PYTHONUNBUFFERED=1
ENV LOG_LEVEL=INFO

CMD ["uvicorn", "src.frontend.admin_panel:app", "--host", "0.0.0.0", "--port", "8081", "--workers", "4"]
